<Window x:Class="YandexDiskDownloader.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yandex Disk Downloader" Width="1080" Height="760" MinWidth="920" MinHeight="650" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Yandex Disk Downloader" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="Публичные файлы Яндекс Диска · Windows" Foreground="#607086" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E1E6ED" BorderThickness="1">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Публичная ссылка" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" ToolTip="https://disk.yandex.ru/d/…"/>
          <Button Grid.Column="1" Content="Проверить" Margin="12,0,0,0" Click="Inspect" IsEnabled="{Binding CanEdit}"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="Куда сохранить" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Destination}" IsReadOnly="True"/>
          <Button Grid.Column="1" Content="Выбрать папку" Margin="12,0,0,0" Click="ChooseFolder" IsEnabled="{Binding CanEdit}"/>
        </Grid>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,18">
      <TextBlock Text="Одновременно:" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox Width="68" ItemsSource="{Binding ParallelOptions}" SelectedItem="{Binding Parallelism}" IsEnabled="{Binding CanEdit}" Margin="0,0,22,0"/>
      <CheckBox Content="Проверять SHA-256 / MD5" IsChecked="{Binding VerifyHashes}" IsEnabled="{Binding CanEdit}"/>
      <CheckBox Content="Пропускать совпадающие файлы" IsChecked="{Binding SkipExisting}" IsEnabled="{Binding CanEdit}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Button Content="{Binding StartLabel}" Click="Start" IsEnabled="{Binding CanStart}" Background="#DCEEFD" BorderBrush="#7AA9CF" FontWeight="SemiBold"/>
        <Button Content="Пауза" Click="Pause" IsEnabled="{Binding CanPause}"/>
        <Button Content="Отмена" Click="Cancel" IsEnabled="{Binding CanCancel}"/>
        <Button Content="Повторить ошибки" Click="Retry" IsEnabled="{Binding CanRetry}"/>
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#30445E" Margin="0,0,0,8"/>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="8" IsIndeterminate="{Binding Inspecting}"/>
      <TextBlock Text="{Binding Summary}" Foreground="#607086" Margin="0,8,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="4" Background="White" BorderBrush="#E1E6ED">
      <TabItem Header="Файлы"><DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single">
        <DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="95"/><DataGridTextColumn Header="Статус / ошибка" Binding="{Binding Detail}" Width="330"/></DataGrid.Columns>
      </DataGrid></TabItem>
      <TabItem Header="Предупреждения"><ListBox ItemsSource="{Binding Warnings}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="900" Margin="6"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
      <TabItem Header="История"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Display"/>
        <Button Grid.Row="1" Content="Использовать выбранную ссылку" Click="UseHistory" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}"/>
      </Grid></TabItem>
    </TabControl>
    <TextBlock Grid.Row="5" Text="Ошибочный файл пропускается сразу. Загруженные файлы не перезаписываются." Foreground="#607086" FontSize="12" Margin="0,14,0,0"/>
  </Grid>
</Window>
